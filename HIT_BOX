local function createLabel(parent, size, pos, text, color)
    local label = Instance.new("TextLabel", parent)
    label.Size = size
    label.Position = pos
    label.Text = text
    label.TextColor3 = color
    label.BackgroundTransparency = 1
    label.TextScaled = true
    return label
end

