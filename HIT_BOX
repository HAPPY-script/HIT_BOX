-- Hàm kéo thả
local dragging
local dragInput
local dragStart
local startPos

local function updateInput(input, frame)
    local delta = input.Position - dragStart
    frame.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
end

local function makeDraggable(frame)
    local function inputStart(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            dragStart = input.Position
            startPos = frame.Position

            input.Changed:Connect(function()
                if input.UserInputState == Enum.UserInputState.End then
                    dragging = false
                end
            end)
        end
    end

    local function inputChanged(input)
        if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
            dragInput = input
        end
    end

    frame.InputBegan:Connect(inputStart)
    frame.InputChanged:Connect(inputChanged)

    userInputService.InputChanged:Connect(function(input)
        if dragging and input == dragInput then
            updateInput(input, frame)
        end
    end)
end

-- Làm cho các frame có thể kéo thả
makeDraggable(mainFrame)

-- Bật/tắt chế độ khi click vào nút
toggleButton.MouseButton1Click:Connect(function()
    _G.Disabled = not _G.Disabled
    toggleButton.Text = _G.Disabled and "OFF" or "ON"
    toggleButton.BackgroundColor3 = _G.Disabled and Color3.new(0.5, 0.5, 0.5) or Color3.new(0, 1, 0)

    while not _G.Disabled do
        for _, v in pairs(game:GetService('Players'):GetPlayers()) do
            if v.Name ~= player.Name then
                pcall(function()
                    local humanoidRootPart = v.Character:FindFirstChild("HumanoidRootPart")
                    if humanoidRootPart then
                        humanoidRootPart.Size = Vector3.new(_G.HeadSize or 20, _G.HeadSize or 20, _G.HeadSize or 20)
                        humanoidRootPart.Transparency = transparencyInput.Text ~= "" and tonumber(transparencyInput.Text) or 0.5
                        humanoidRootPart.BrickColor = _G.Color or BrickColor.new("Really white")
                        humanoidRootPart.Material = "Neon"
                        humanoidRootPart.CanCollide = false
                    end
                end)
            end
        end
        runService.RenderStepped:Wait()
    end

    for _, v in pairs(game:GetService('Players'):GetPlayers()) do
        if v.Name ~= player.Name then
            pcall(function()
                local humanoidRootPart = v.Character:FindFirstChild("HumanoidRootPart")
                if humanoidRootPart then
                    humanoidRootPart.CanCollide = true
                end
            end)
        end
    end
end)

